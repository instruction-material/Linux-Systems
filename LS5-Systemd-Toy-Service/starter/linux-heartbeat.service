[Unit]
Description=Owned Linux course heartbeat
StartLimitIntervalSec=10
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/.local/share/linux-heartbeat
Environment=HEARTBEAT_INTERVAL=5
Environment=HEARTBEAT_MESSAGE=linux-heartbeat
Environment=HEARTBEAT_LIMIT=0
EnvironmentFile=%h/.local/share/linux-heartbeat/heartbeat.env
ExecStart=/usr/bin/python3 -u %h/.local/share/linux-heartbeat/heartbeat_app.py
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=1
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
