[Unit]
Description=Linux Systems heartbeat service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/linux-heartbeat
EnvironmentFile=-/etc/default/linux-heartbeat
Environment=HEARTBEAT_INTERVAL=5
Environment=HEARTBEAT_MESSAGE=linux-heartbeat
ExecStart=/usr/bin/python3 /opt/linux-heartbeat/heartbeat_app.py
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
