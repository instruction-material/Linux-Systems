[Unit]
Description=Owned operations capstone @@UNIT@@
StartLimitIntervalSec=10
StartLimitBurst=3

[Service]
Type=simple
DynamicUser=yes
# TODO: select the rendered current release directory.
WorkingDirectory=@@ROOT@@/missing-release
ExecStart=/usr/bin/python3 @@ROOT@@/current/app.py --config @@ROOT@@/current/config.json --port @@APP_PORT@@
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
